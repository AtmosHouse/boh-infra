# Database — defaults to local SQLite (./recipes.db) if unset.
# For Postgres, use an async driver URL, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/recipes
DATABASE_URL=sqlite+aiosqlite:///./recipes.db

# LLM provider for ingredient parsing (OpenAI-compatible API)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8
